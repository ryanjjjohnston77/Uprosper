# Copy the variable names below into Replit Secrets or your deployment
# provider's secret manager. Never commit real values to this file.

# Required for secure session cookies
SESSION_SECRET=

# Used only when the initial admin account needs to be created
ADMIN_PASSWORD=

# Optional web-push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@uprosper.com

# DATABASE_URL and Replit connector/runtime variables are provisioned by
# Replit. Do not copy their values into this file or commit them to Git.